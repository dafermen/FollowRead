# API local. No agregues credenciales AWS ni contraseñas reales.
FOLLOWREAD_ENVIRONMENT=development
FOLLOWREAD_APP_NAME=FollowRead API
FOLLOWREAD_API_PREFIX=
FOLLOWREAD_DATABASE_URL=sqlite:///./var/followread.db

# Audio. Mantén `fake` si no quieres consumir una API.
FOLLOWREAD_POLLY_PROVIDER=fake
FOLLOWREAD_AUDIO_OUTPUT_DIR=./var/audio
FOLLOWREAD_POLLY_CHUNK_CHARACTERS=1500
FOLLOWREAD_MAXIMUM_PROCESSING_COST=1.00

# OpenAI: copia este archivo como apps/api/.env y completa la clave sólo allí.
# Después cambia FOLLOWREAD_POLLY_PROVIDER a openai y reinicia `pnpm dev`.
OPENAI_API_KEY=
FOLLOWREAD_OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
FOLLOWREAD_OPENAI_ALIGNMENT_MODEL=whisper-1
