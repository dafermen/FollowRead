{
  "name": "followread",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Accessible synchronized reading platform for children, adult readers, and English learners.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.9.0 <12"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "5.9.3",
    "typescript-eslint": "catalog:"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:check": "node scripts/dev.mjs --check",
    "setup": "pnpm install --frozen-lockfile && pnpm setup:python && pnpm hooks:install",
    "setup:python": "node scripts/setup-python.mjs",
    "check": "pnpm docs:validate && pnpm validate:ci && pnpm deploy:validate && pnpm mobile:validate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "ci": "pnpm check",
    "build": "pnpm --recursive --if-present run build",
    "test": "pnpm test:js && pnpm test:python",
    "test:js": "pnpm --recursive --if-present run test:coverage",
    "test:python": "node scripts/run-python.mjs -m pytest apps/api --basetemp=.pytest-temp --cov=followread_api --cov-report=term-missing -W error",
    "typecheck": "pnpm typecheck:js && pnpm typecheck:python",
    "typecheck:js": "pnpm --recursive --if-present run typecheck",
    "typecheck:python": "node scripts/run-python.mjs -m mypy apps/api/src apps/api/tests",
    "lint": "pnpm lint:js && pnpm lint:python",
    "lint:js": "eslint apps/admin-web/src apps/reader/src packages scripts/*.mjs",
    "lint:python": "node scripts/run-python.mjs -m ruff check apps/api scripts",
    "format:check": "pnpm format:check:js && pnpm format:check:python",
    "format:check:js": "prettier --check \"apps/{admin-web,reader}/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,json}\" \"*.{json,yaml}\" \"eslint.config.js\" \"scripts/*.mjs\"",
    "format:check:python": "node scripts/run-python.mjs -m ruff format --check apps/api scripts",
    "hooks:install": "node scripts/setup-hooks.mjs",
    "hooks:verify": "node scripts/verify-hooks.mjs",
    "migrate": "node scripts/run-python.mjs -m alembic -c apps/api/alembic.ini upgrade head",
    "migrate:down": "node scripts/run-python.mjs -m alembic -c apps/api/alembic.ini downgrade -1",
    "admin:bootstrap": "node scripts/run-python.mjs -m followread_api.cli.bootstrap_superadmin",
    "demo:seed": "node scripts/run-python.mjs -m followread_api.cli.seed_demo_story",
    "offline:bootstrap": "node scripts/export-offline-bootstrap.mjs",
    "reader:e2e": "node scripts/verify-reader-e2e.mjs",
    "reader:offline-e2e": "node scripts/verify-reader-offline-e2e.mjs",
    "reader:mobile-e2e": "node scripts/verify-reader-mobile-e2e.mjs",
    "reader:learning-e2e": "node scripts/verify-learning-e2e.mjs",
    "quality:a11y": "node scripts/verify-accessibility.mjs",
    "quality:budget": "node scripts/verify-quality-budget.mjs",
    "quality:load": "node scripts/load-test.mjs",
    "quality:regression": "node scripts/run-regression.mjs",
    "security:audit": "pnpm security:audit:js && pnpm security:audit:python",
    "security:audit:js": "pnpm audit --audit-level moderate",
    "security:audit:python": "node scripts/run-python.mjs -m pip_audit",
    "docs:validate": "node scripts/validate-documentation.mjs",
    "deploy:validate": "node scripts/validate-deployment.mjs",
    "deploy:local": "node scripts/deploy-compose.mjs --environment local --env-file infrastructure/deployment/local.example.env",
    "deploy:smoke": "node scripts/deployment-smoke-test.mjs",
    "deploy:backup": "node scripts/run-python.mjs -m followread_api.cli.database_backup backup",
    "deploy:restore": "node scripts/run-python.mjs -m followread_api.cli.database_backup restore",
    "release:notes": "node scripts/release-notes.mjs",
    "mobile:doctor": "node scripts/mobile-doctor.mjs",
    "mobile:validate": "node scripts/validate-mobile.mjs",
    "mobile:assets": "pnpm --filter @followread/reader mobile:assets",
    "mobile:sync": "pnpm --filter @followread/reader mobile:sync",
    "mobile:sync:android": "pnpm --filter @followread/reader mobile:sync:android",
    "mobile:sync:ios": "pnpm --filter @followread/reader mobile:sync:ios",
    "mobile:open:android": "pnpm --filter @followread/reader mobile:open:android",
    "mobile:open:ios": "pnpm --filter @followread/reader mobile:open:ios",
    "mobile:build:android": "pnpm mobile:sync:android && node scripts/mobile-build.mjs android",
    "mobile:build:ios": "pnpm --filter @followread/reader mobile:build:ios",
    "mobile:run:android": "pnpm --filter @followread/reader mobile:run:android",
    "mobile:run:ios": "pnpm --filter @followread/reader mobile:run:ios",
    "validate:ci": "node scripts/run-python.mjs scripts/validate_workflow.py"
  }
}
